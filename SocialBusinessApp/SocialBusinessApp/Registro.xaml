<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialBusinessApp.Registro">
    <ContentPage.Content>
        <StackLayout Padding="20,20,20,20" BackgroundColor="#FFFFFF">
            <Label Text="Bienvenido a Social Business PRO, Por favor completar los sigientes datos para el registro" FontSize="20" HorizontalOptions="Center"></Label>
            <Entry x:Name="txtNombres" Placeholder="Nombre" WidthRequest="250"  HorizontalTextAlignment="Center" Text="" HorizontalOptions="Center" RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent,Property=Height,Factor=1,Constant=250}" RelativeLayout.WidthConstraint="{ConstraintExpression Type=RelativeToParent,Property=Width,Factor=.5}"></Entry>
            <Entry x:Name="txtApellidos" Placeholder="Apellido" WidthRequest="250"  HorizontalTextAlignment="Center" Text="" HorizontalOptions="Center" RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent,Property=Height,Factor=1,Constant=250}" RelativeLayout.WidthConstraint="{ConstraintExpression Type=RelativeToParent,Property=Width,Factor=.5}"></Entry>
            <Entry x:Name="txtEmail" Placeholder="Correo electrónico" WidthRequest="250" Keyboard="Email" HorizontalTextAlignment="Center" Text="" HorizontalOptions="Center" RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent,Property=Height,Factor=1,Constant=250}" RelativeLayout.WidthConstraint="{ConstraintExpression Type=RelativeToParent,Property=Width,Factor=.5}"></Entry>
            <Entry x:Name="txtCelu" Placeholder="Teléfono" WidthRequest="250" Keyboard="Numeric" HorizontalTextAlignment="Center" Text="" HorizontalOptions="Center" RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent,Property=Height,Factor=1,Constant=250}" RelativeLayout.WidthConstraint="{ConstraintExpression Type=RelativeToParent,Property=Width,Factor=.5}"></Entry>
            <Entry x:Name="txtContrasena" Placeholder="Contraseña" WidthRequest="250"  IsPassword="True" HorizontalTextAlignment="Center" Text="" HorizontalOptions="Center" RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent,Property=Height,Factor=1,Constant=250}" RelativeLayout.WidthConstraint="{ConstraintExpression Type=RelativeToParent,Property=Width,Factor=.5}"></Entry>
            <Entry x:Name="txtContrasena2" Placeholder="Repita Contraseña" WidthRequest="250" IsPassword="True" HorizontalTextAlignment="Center" Text="" HorizontalOptions="Center" RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent,Property=Height,Factor=1,Constant=250}" RelativeLayout.WidthConstraint="{ConstraintExpression Type=RelativeToParent,Property=Width,Factor=.5}"></Entry>
            <Button x:Name="btnRegistrarmeRegistro" Text="Registrarse" BackgroundColor="#9c27b0"  WidthRequest="150" TextColor="#FFFFFF" RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent,Property=Height,Factor=1,Constant=250}" RelativeLayout.WidthConstraint="{ConstraintExpression Type=RelativeToParent,Property=Width,Factor=.5}" ></Button>
        </StackLayout>
        
    </ContentPage.Content>
</ContentPage>