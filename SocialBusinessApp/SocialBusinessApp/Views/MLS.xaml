<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SuaveControls.Views;assembly=SuaveControls.FloatingActionButton"
             x:Class="SocialBusinessApp.MLS"
             Title="MLS">
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Orientation="Horizontal">
                <ActivityIndicator x:Name="waitActivityIndicator" HeightRequest="50" HorizontalOptions="Center" IsVisible="false"></ActivityIndicator>
                <Label Text="MLS" HorizontalOptions="CenterAndExpand" FontSize="25" TextColor="#9c27b0" Font="Bold,25"/>
            </StackLayout>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackLayout  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2">
                    <StackLayout Orientation="Horizontal" Padding="5,5,5,5" HorizontalOptions="FillAndExpand">
                        <Entry x:Name="txtSearch" Placeholder="¿Qué estás buscando?" HorizontalOptions="FillAndExpand"></Entry>
                        <Button Image="lupa.png" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" x:Name="btnSearch" BackgroundColor="#9c27b0"></Button>
                    </StackLayout>
                    <ListView CachingStrategy ="RecycleElement" x:Name="OfertasListView" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowHeight="111"/>
                </StackLayout>
                <views:FloatingActionButton Image="mas.png" Grid.Column="1" Grid.Row="1" ButtonColor="#9c27b0" WidthRequest="56" HeightRequest="56" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" x:Name="btnAgregarOferta"/>
                <StackLayout Grid.Column="0" Grid.Row="1" Orientation="Horizontal">
                    <Label Text="  "></Label>
                    <views:FloatingActionButton Image="usuario.png" Grid.Column="0" Grid.Row="1" ButtonColor="#9c27b0" WidthRequest="56" HeightRequest="56" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" x:Name="btnPerfil"/>
                </StackLayout>
            </Grid>
            
            
            
            
            
        </StackLayout>
    </ContentPage.Content>
</ContentPage>