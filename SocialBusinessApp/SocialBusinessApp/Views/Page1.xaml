<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SocialBusinessApp"
             xmlns:flv="clr-namespace:DLToolkit.Forms.Controls;assembly=DLToolkit.Forms.Controls.FlowListView"
             x:Class="SocialBusinessApp.Views.Page1">
    <ContentPage.Content>
        <StackLayout>
            <Button Clicked="Button_Clicked" Text="Clcik me"/>
            <flv:FlowListView FlowColumnCount="3" 
                          x:Name="listItems" 
					      SeparatorVisibility="None"
						  HasUnevenRows="false"
                          RowHeight="100" >

                <flv:FlowListView.FlowColumnTemplate>
                    <DataTemplate >
                        <Image Source="{Binding .}" HorizontalOptions="Fill" VerticalOptions="Fill" />
                    </DataTemplate>
                </flv:FlowListView.FlowColumnTemplate>

            </flv:FlowListView>

        </StackLayout>
    </ContentPage.Content>
</ContentPage>