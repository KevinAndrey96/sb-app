<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialBusinessApp.Asociaciones">
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Orientation="Horizontal" Padding="5,5,5,5" HorizontalOptions="FillAndExpand">
                <Entry x:Name="txtSearch" Placeholder="¿Alguna franquicia en especial?" HorizontalOptions="FillAndExpand"></Entry>
                <Button Image="lupa.png" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" x:Name="btnSearch" BackgroundColor="#9c27b0"></Button>
            </StackLayout>
            <ListView x:Name="AsociacionesListView" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowHeight="111"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>