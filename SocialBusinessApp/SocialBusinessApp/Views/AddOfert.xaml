<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialBusinessApp.Listado">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="20,20,20,20" BackgroundColor="#FFFFFF">
                <Label Text="Nueva Oferta" FontSize="25"></Label>
                <Entry x:Name="txtNO" Placeholder="Nombre de la oferta"></Entry>
                <Label Text="Dirección y Ubicación" FontSize="25"></Label>
                <Picker x:Name="txtDepartamento"  Title="Departamento"  HorizontalOptions="FillAndExpand">
                    <Picker.Items>
                        <x:String>Amazonas</x:String>
                        <x:String>Antioquia</x:String>
                        <x:String>Arauca</x:String>
                        <x:String>Atlántico</x:String>
                        <x:String>Bogotá</x:String>
                        <x:String>Bolívar</x:String>
                        <x:String>Boyacá</x:String>
                        <x:String>Caldas</x:String>
                        <x:String>Caquetá</x:String>
                        <x:String>Casanare</x:String>
                        <x:String>Cauca</x:String>
                        <x:String>Cesar</x:String>
                        <x:String>Chocó</x:String>
                        <x:String>Córdoba</x:String>
                        <x:String>Cundinamarca</x:String>
                        <x:String>Guainía</x:String>
                        <x:String>Guaviare</x:String>
                        <x:String>Huila</x:String>
                        <x:String>La Guajira</x:String>
                        <x:String>Magdalena</x:String>
                        <x:String>Meta</x:String>
                        <x:String>Nariño</x:String>
                        <x:String>Norte de Santander</x:String>
                        <x:String>Putumayo</x:String>
                        <x:String>Quindío</x:String>
                        <x:String>Risaralda</x:String>
                        <x:String>San Andrés y Providencia</x:String>
                        <x:String>Santander</x:String>
                        <x:String>Sucre</x:String>
                        <x:String>Tolima</x:String>
                        <x:String>Valle del Cauca</x:String>
                        <x:String>Vaupés</x:String>
                        <x:String>Vichada</x:String>
                    </Picker.Items>
                </Picker>
                <Entry x:Name="txtCi" Placeholder="Ciudad"></Entry>
                <Entry x:Name="txtBar" Placeholder="Barrio"></Entry>
                <Entry x:Name="txtDi" Placeholder="Dirección"></Entry>
                <Entry x:Name="txtPr" Keyboard="Numeric" Placeholder="Precio"></Entry>
                <Entry x:Name="txtAr" Keyboard="Numeric" Placeholder="Area (m2)"></Entry>
                <Picker x:Name="txtUbicación" Title="Ubicación"  HorizontalOptions="FillAndExpand">
                    <Picker.Items>
                        <x:String>Norte</x:String>
                        <x:String>Sur</x:String>
                        <x:String>Oriente</x:String>
                        <x:String>Occidente</x:String>
                    </Picker.Items>
                </Picker>
                <Entry x:Name="txtHa"  Keyboard="Numeric" Placeholder="Habitaciones"></Entry>
                <Entry x:Name="txtBa" Keyboard="Numeric"  Placeholder="Baños"></Entry>
                <Entry x:Name="txtPa"  Keyboard="Numeric" Placeholder="Parqueaderos"></Entry>
                <Picker x:Name="txtEstrato" Title="Estrato"  HorizontalOptions="FillAndExpand">
                    <Picker.Items>
                        <x:String>1</x:String>
                        <x:String>2</x:String>
                        <x:String>3</x:String>
                        <x:String>4</x:String>
                        <x:String>5</x:String>
                        <x:String>6</x:String>
                        <x:String>Campestre</x:String>
                    </Picker.Items>
                </Picker>
                <Picker x:Name="txtAntiguedad" Title="Antiguedad"  HorizontalOptions="FillAndExpand">
                    <Picker.Items>
                        <x:String>Proyecto en Planos</x:String>
                        <x:String>Proyecto en construcción</x:String>
                        <x:String>Estrenar</x:String>
                        <x:String>Hasta 3 años</x:String>
                        <x:String>Hasta 6 años</x:String>
                        <x:String>Hasta 10 años</x:String>
                        <x:String>Hasta 15 años</x:String>
                        <x:String>Hasta 20 años</x:String>
                        <x:String>Más de 20 años</x:String>
                    </Picker.Items>
                </Picker>

                <Label Text="Contacto y otra información" FontSize="25"></Label>
                <Entry x:Name="txtTe" Placeholder="Telefono" Keyboard="Numeric"></Entry>
                <Entry x:Name="txtDe" Placeholder="Descripcion"></Entry>
                <Label Text="Inmueble" FontSize="25"></Label>
                <Picker x:Name="txtCategoria" Title="Categoria"  HorizontalOptions="FillAndExpand">
                    <Picker.Items>
                        <x:String>Apartamento</x:String>
                        <x:String>Apartaestudio</x:String>
                        <x:String>Casa</x:String>
                        <x:String>Finca</x:String>
                        <x:String>Lote</x:String>
                        <x:String>Local</x:String>
                        <x:String>Bodega</x:String>
                        <x:String>Edificio</x:String>
                    </Picker.Items>
                </Picker>
                <Picker x:Name="txtTipo" Title="Tipo"  HorizontalOptions="FillAndExpand">
                    <Picker.Items>
                        <x:String>Venta</x:String>
                        <x:String>Arriendo</x:String>
                        <x:String>Alquiler Vacacional</x:String>
                        <x:String>Permuta</x:String>
                        <x:String>Venta-Permuta</x:String>
                        <x:String>Arriendo-Permuta</x:String>
                    </Picker.Items>
                </Picker>
                <Picker x:Name="TxtTerceria" Title="Terceria"  HorizontalOptions="FillAndExpand">
                    <Picker.Items>
                        <x:String>Si</x:String>
                        <x:String>No</x:String>
                    </Picker.Items>
                </Picker>
                <Image x:Name="image1" />
                <Button Clicked="Button_Clicked1" Text="Seleccionar Imagen 1" />
                <Image x:Name="image2" />
                <Button Clicked="Button_Clicked2" Text="Seleccionar Imagen 2" />
                <Image x:Name="image3" />
                <Button Clicked="Button_Clicked3" Text="Seleccionar Imagen 3" />
                <Image x:Name="image4" />
                <Button Clicked="Button_Clicked4" Text="Seleccionar Imagen 4" />
                <Image x:Name="image5" />
                <Button Clicked="Button_Clicked5" Text="Seleccionar Imagen 5" />
                <Button x:Name="btnPublicar" Text="Publicar" BackgroundColor="#9c27b0" TextColor="#FFFFFF"></Button>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>