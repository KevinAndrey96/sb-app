<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialBusinessApp.CambiarContrasena">
    <ContentPage.Content>
        <StackLayout Padding="20,50,20,20">
            <StackLayout Padding="20,20,20,20" >
                <Image Source="sbicon" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center"/>
            </StackLayout>
            <Entry x:Name="txtContraAct" Placeholder="Contraseña Actual"  IsPassword="True"></Entry>
            <Entry x:Name="txtContraNue" Placeholder="Contraseña Nueva"   IsPassword="True"></Entry>
            <Entry x:Name="txtContraNue2" Placeholder="Repita Nueva Contraseña"   IsPassword="True"></Entry>
            <Button Image="ok.png" x:Name="btnCambiarContrasena" Text="Cambiar contraseña"  BackgroundColor="#9c27b0" TextColor="#FFFFFF"></Button>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>