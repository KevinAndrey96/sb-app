<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialBusinessApp.Views.Logros">
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Padding="10,10,0,0">
                <Label Text="Logros" TextColor="#9c27b0" HorizontalOptions="Center" FontSize="25"></Label>
                <StackLayout Orientation="Horizontal">
                    <Label Text="Puntaje" WidthRequest="80" TextColor="#9c27b0" HorizontalOptions="Center" FontSize="17"></Label>
                    <Label Text="Logro" TextColor="#9c27b0" HorizontalOptions="Center" FontSize="17"></Label>
                </StackLayout>
                
                <ListView x:Name="LogrosListView" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowHeight="30"/>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>